{
    "name": "ifhub/ifhub",
    "description": "ifhub.ru, based on LiveStreet CMS",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.5",
        "imagine/imagine": "^1.5",
        "matthiasmullie/minify": "^1.3",
        "monolog/monolog": "^3.9",
        "natxet/cssmin": "^3.0",
        "phpmailer/phpmailer": "^7.1",
        "psr/log": "^3.0",
        "smarty/smarty": "^5.8",
        "symfony/console": "^8.1",
        "xxtea/xxtea": "^1.0"
    },
    "autoload": {
        "classmap": [
            "framework/libs/application/SmartyLS/"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "symfony/var-dumper": "^8.1",
        "symplify/phpstan-rules": "^14.19"
    }
}
